; Recursion Examples for TidyVM Clean

; Factorial - Classic recursive example
(define factorial
  (lambda (n)
    (if (= n 0)
        1
        (* n (factorial (- n 1))))))

(factorial 5)   ; Should be 120
(factorial 10)  ; Should be 3628800

; Fibonacci - Double recursion
(define fib
  (lambda (n)
    (if (< n 2)
        n
        (+ (fib (- n 1)) 
           (fib (- n 2))))))

(fib 8)   ; Should be 21
(fib 12)  ; Should be 144

; Sum list - Recursive list processing
(define sum-list
  (lambda (lst)
    (if (null? lst)
        0
        (+ (car lst) (sum-list (cdr lst))))))

(sum-list (q (1 2 3 4 5)))  ; Should be 15

; Length of list - Another list recursion
(define length
  (lambda (lst)
    (if (null? lst)
        0
        (+ 1 (length (cdr lst))))))

(length (q (a b c d e)))  ; Should be 5

(q done)
