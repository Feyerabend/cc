# Simple cube model
# Vertices
v -1.0 -1.0 -1.0
v  1.0 -1.0 -1.0
v  1.0  1.0 -1.0
v -1.0  1.0 -1.0
v -1.0 -1.0  1.0
v  1.0 -1.0  1.0
v  1.0  1.0  1.0
v -1.0  1.0  1.0

# Faces (triangles)
# Back face
f 1 2 3
f 1 3 4
# Front face
f 5 7 6
f 5 8 7
# Left face
f 1 4 8
f 1 8 5
# Right face
f 2 6 7
f 2 7 3
# Bottom face
f 1 5 6
f 1 6 2
# Top face
f 4 3 7
f 4 7 8
