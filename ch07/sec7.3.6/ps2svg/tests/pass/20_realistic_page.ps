%!PS-Adobe-3.0
%%Title: Realistic Page
%%BoundingBox: 0 0 595 842

/cm { 28.3465 mul } def

gsave
  % Page border
  2 setlinewidth
  0 setgray
  newpath
  1 cm 1 cm moveto
  19 cm 1 cm lineto
  19 cm 28 cm lineto
  1 cm 28 cm lineto
  closepath
  stroke

  % Title block
  /Times-Bold 24 setfont
  3 cm 26 cm moveto
  (Annual Report 2024) show

  % Horizontal rule
  1 setlinewidth
  2 cm 25.5 cm moveto
  18 cm 25.5 cm lineto
  stroke

  % Body text placeholder
  /Times-Roman 12 setfont
  2 cm 24 cm moveto
  (This document was generated by the PostScript parser test suite.) show

  % A coloured box
  0.8 0.2 0.2 setrgbcolor
  newpath
  2 cm 5 cm moveto
  8 cm 5 cm lineto
  8 cm 8 cm lineto
  2 cm 8 cm lineto
  closepath
  fill

  % A circle
  0 0.5 1 setrgbcolor
  newpath
  14 cm 6.5 cm 1.5 cm 0 360 arc
  fill

grestore
showpage
