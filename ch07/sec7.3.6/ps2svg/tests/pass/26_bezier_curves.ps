%!PS
% Cubic Bézier curves — absolute and relative
gsave
  2 setlinewidth
  0 0 1 setrgbcolor

  % S-curve using two cubics
  newpath
  50 100 moveto
  80 160  120 160  150 100 curveto
  180 40  220 40   250 100 curveto
  stroke

  % Spiral-like using rcurveto
  1 0 0 setrgbcolor
  newpath
  150 400 moveto
  30 60  70 60  100 0 rcurveto
  60 -30  60  30  0  60 rcurveto
  stroke
grestore
showpage
